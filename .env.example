# ---------------------------------------------------------------- agent
# Leave the key empty to use the offline demo parser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------- database
# d1    = Cloudflare D1 over the HTTP API (production)
# local = SQLite file at data/jobpilot.db (offline dev and tests)
# Leave blank to auto-pick: d1 when the three Cloudflare values below are set.
JOB_DB=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token with the "D1 Edit" permission for this account.
CLOUDFLARE_API_TOKEN=

# Only used when JOB_DB=local
LOCAL_DB_PATH=

# ---------------------------------------------------------------- file storage
# r2    = Cloudflare R2 (CV, generated letters, advert snapshots)
# local = data/files folder for offline work
FILE_STORAGE=
R2_BUCKET=jobpilot-files
# Separate from CLOUDFLARE_API_TOKEN: R2 -> API -> Manage API tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults to CLOUDFLARE_ACCOUNT_ID when empty.
R2_ACCOUNT_ID=
LOCAL_FILES_PATH=
